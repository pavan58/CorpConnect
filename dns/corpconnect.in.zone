; corpconnect.in -- BIND-style. TTL 3600 unless noted.
; Web (Vercel)
@                 IN A      76.76.21.21
www               IN CNAME  cname.vercel-dns.com.

; Resend sending (region ap-northeast-1). Return-Path + SPF live on the "send" subdomain,
; so they never collide with an existing root SPF (Google Workspace / M365).
send              IN MX 10  feedback-smtp.ap-northeast-1.amazonses.com.
send              IN TXT    "v=spf1 include:amazonses.com ~all"
; DKIM: value is unique per domain. Run scripts/resend-dns.sh and paste the exact "p=..." string.
resend._domainkey IN TXT    "p=<PASTE_FROM_scripts/resend-dns.sh_OUTPUT>"

; DMARC: start at p=none, move to quarantine, then reject after ~4 clean weeks of reports.
_dmarc            IN TXT    "v=DMARC1; p=none; rua=mailto:dmarc@corpconnect.in; adkim=s; aspf=s; fo=1"

; HSTS preload prerequisite: apex + www must both serve HTTPS (Vercel does this automatically).
