# Copy to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — leave RESEND_API_KEY empty locally and OTP codes are printed to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CorpConnect <no-reply@corpconnect.it.com>
RESEND_WEBHOOK_SECRET=

# 32+ random bytes, e.g. `openssl rand -base64 32`. Used to HMAC OTP codes at rest.
OTP_SECRET=
